{
  "name": "healthcare-rag-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Cheap-by-default healthcare benefits RAG proof of concept with local OSS and AWS smoke profiles.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:local": "tsx scripts/run-evals.ts --profile local --out evals/reports/local-eval.json",
    "cdk:synth:smoke": "tsx infra/cdk/bin/app.ts --profile aws-smoke --out cdk.out/smoke",
    "cdk:synth:full": "tsx infra/cdk/bin/app.ts --profile aws-full --out cdk.out/full",
    "cdk:nag": "pnpm cdk:synth:smoke && tsx scripts/check-smoke-cost-shape.ts cdk.out/smoke",
    "docker:local": "docker compose -f deploy/docker-compose.local.yml config",
    "demo-local": "tsx scripts/demo-local.ts",
    "api-local": "tsx apps/api/src/local-server.ts",
    "web:dev": "pnpm --filter @healthcare-rag/web dev",
    "web:build": "pnpm --filter @healthcare-rag/web build",
    "web:test": "pnpm --filter @healthcare-rag/web test",
    "build:lambda-artifacts": "bash scripts/build-lambda-artifacts.sh",
    "build:local-index": "tsx scripts/build-local-index.ts",
    "build:index-artifact": "tsx scripts/build-index-artifact.ts",
    "smoke:cost-shape": "tsx scripts/check-smoke-cost-shape.ts cdk.out/smoke"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.812.0",
    "@aws-sdk/client-dynamodb": "^3.812.0",
    "@aws-sdk/client-eventbridge": "^3.812.0",
    "@aws-sdk/client-s3": "^3.812.0",
    "@aws-sdk/lib-dynamodb": "^3.812.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "aws-cdk-lib": "^2.195.0",
    "constructs": "^10.4.2",
    "pg": "^8.15.6",
    "pnpm": "^11.1.1",
    "tsx": "^4.19.4",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "@types/pg": "^8.11.14",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "type": "module"
}
